{% extends 'base.html.twig' %}

{% block title %}Carte des clubs{% endblock %}
{% block body_id %}homepage{% endblock %}

{% block body %}
<section class="container text-center py-3">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <h1 class="fw-bold mb-4 display-5 text-dark">Groundhoptools</h1>
      <p class="fs-5 mb-4 text-secondary">
        <strong>Groundhoptools</strong> est un outil de <em>Groundhopping</em> conçu pour faciliter la recherche de matchs se trouvant autour de vous.
      </p>
      <p class="fs-5 mb-4 text-secondary">
        Pour l'utiliser, il suffit de sélectionner deux dates dans le calendrier ci-dessous : la date de début et la date de fin de votre séjour.
        Si vous souhaitez voir les matchs sur une seule journée, sélectionnez simplement ce jour comme date de début <strong>et</strong> de fin.
      </p>
      <p class="fs-5 mb-4 text-secondary">
        Une fois la période choisie, cliquez sur le bouton <strong>« Voir les clubs à domicile »</strong>.
        Tous les clubs jouant à domicile s'affichent alors. En cliquant sur un club, vous pouvez voir le nom de son stade
        ainsi que la liste de ses adversaires pendant la période sélectionnée.
      </p>
      <p class="fs-5 text-secondary">
        Créer un compte vous permet d'enregistrer les clubs déjà visités afin de les masquer dans vos prochains résultats de recherche pour rendre votre expérience de Groundhopping encore plus fluide et personnalisée.
      </p>
    </div>
  </div>
</section>

<div class="container mb-4 text-center">
  <div class="d-flex justify-content-center gap-3 flex-wrap align-items-center mb-2">
    <input type="text" id="daterange" class="form-control text-center"
           placeholder="Choisis une période" style="max-width: 250px;">
    <button id="load-matches" class="btn btn-dark">Voir les clubs à domicile</button>
  </div>

  {% if app.user %}
  <div class="form-check form-switch d-flex justify-content-center align-items-center mt-2">
    <input class="form-check-input me-2" type="checkbox" id="hide-visited">
    <label class="form-check-label" for="hide-visited">Masquer les clubs déjà visités</label>
  </div>
  {% endif %}
</div>

{# Pont Twig → JS via data-attributes #}
<div id="map"
     style="height: 800px; width: 80%; margin: 0 auto 50px auto;"
     data-clubs="{{ clubs|json_encode() }}"
     data-api-url="{{ path('api_matchs') }}"
     data-logos-url="{{ asset('images/logos/') }}">
</div>

<div id="user-schedule" class="container text-center mb-4">
  <h4>Mon programme de Groundhopping</h4>
  <ul id="schedule-list" class="list-group mb-3"></ul>
  <div id="schedule-total" class="fs-5 text-secondary mb-2"></div>
  <div class="d-flex justify-content-center gap-2 mb-2">
    <button id="reset-schedule" class="btn btn-warning">Réinitialiser le programme</button>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="https://unpkg.com/@mapbox/polyline"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
<script src="{{ asset('js/map.js') }}"></script>
{% endblock %}